{
  "name": "multicall-correcao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "build": "npm run build:api && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build:api": "node scripts/build-api.mjs",
    "companies": "node --env-file-if-exists=.env scripts/list-companies.ts",
    "pretest": "npm run build:api"
  },
  "dependencies": {
    "@vercel/functions": "3.9.11",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
