# Node.js 24+. Nunca coloque chaves no frontend ou no controle de versão.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/autocab.sqlite
# Quando preenchido usa PostgreSQL/Neon; obrigatório na Vercel.
DATABASE_URL=
# Token exclusivo do agendador (cron da Vercel); use um valor diferente de PANEL_TOKEN.
CRON_SECRET=
# Passadas extras dentro de cada chamada do cron (ms). 20000 = correção a cada ~20 s; 0 desliga.
CRON_REPEAT_INTERVAL_MS=20000
# demo: fictício | dry: consultas reais, sem POST | live: aplica correções reais
AUTOCAB_MODE=demo
AUTOCAB_BASE_URL=https://autocab-api.azure-api.net
# Subscription Key da Multicall (Vehicle + Booking). Uma única chave atende as empresas.
AUTOCAB_SUBSCRIPTION_KEY=
# GET que lista todas as empresas da chave (npm run companies ou GET /api/companies).
AUTOCAB_COMPANIES_PATH=/booking/v1/companies
# companyId de cada empresa. Vazio: resolvido pelo nome no GET de empresas.
AUTOCAB_COMPANY_ID_ARCOVERDE=
AUTOCAB_COMPANY_ID_SAO_CONRADO=
AUTOCAB_COMPANY_ID_PEDRA_DA_GAVEA=
# Arquivo opcional que substitui as três empresas padrão; sem valores de chaves.
AUTOCAB_CONNECTIONS_FILE=
PROTECTED_ZONES=NAK,FORA DE AREA
OUTSIDE_ZONE_NAME=FORA DE AREA
AUTO_START=true
CYCLE_INTERVAL_MS=60000
# Exigido ao expor HOST fora do loopback. Use HTTPS para acesso remoto.
PANEL_TOKEN=
