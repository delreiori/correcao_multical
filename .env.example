# Node.js 24+. Nunca coloque chaves no frontend ou no controle de versão.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/autocab.sqlite
# Quando preenchido usa PostgreSQL (Supabase Session pooler ou Neon); obrigatório na Vercel.
DATABASE_URL=
# Opcional: certificado PEM extra para o TLS do banco. O do Supabase já vem no código.
DATABASE_SSL_CA=
# Token exclusivo do agendador (cron-job.org); use um valor diferente de PANEL_TOKEN.
CRON_SECRET=
# Passadas extras dentro de cada chamada do cron (ms). 20000 = correção a cada ~20 s; 0 desliga.
CRON_REPEAT_INTERVAL_MS=20000
# demo: fictício | dry: consultas reais, sem POST | live: aplica correções reais
AUTOCAB_MODE=demo
AUTOCAB_BASE_URL=https://autocab-api.azure-api.net
# Subscription Key da Multicall (Vehicle + Booking). Uma única chave atende as empresas.
AUTOCAB_SUBSCRIPTION_KEY=
# GET que lista todas as empresas da chave (npm run companies ou GET /api/companies).
AUTOCAB_COMPANIES_PATH=/booking/v1/companies
# Tempo máximo (ms) de cada requisição à Autocab.
AUTOCAB_TIMEOUT_MS=10000
# companyId de cada empresa. Vazio: resolvido pelo nome no GET de empresas.
AUTOCAB_COMPANY_ID_ARCOVERDE=
AUTOCAB_COMPANY_ID_SAO_CONRADO=
AUTOCAB_COMPANY_ID_PEDRA_DA_GAVEA=
# Arquivo opcional que substitui as três empresas padrão; sem valores de chaves.
AUTOCAB_CONNECTIONS_FILE=
# Avisos de fila aos motoristas (Arcoverde): off | dry (só registra no painel) | live (envia).
# live envia de verdade mesmo com AUTOCAB_MODE=dry (para testar com poucos motoristas).
DRIVER_MESSAGES_MODE=dry
# Reservas São Conrado: off | dry | live. Destinatários: todos os motoristas da São Conrado.
# Exige PostgreSQL; independente dos avisos de fila da Arcoverde e de AUTOCAB_MODE=dry.
RESERVATION_MESSAGES_MODE=off
# Opcional: só estes callsigns/IDs recebem os avisos (ex.: 5013). Vazio = todos os motoristas.
DRIVER_MESSAGES_ONLY=
# Opcional: limita o aviso aos N primeiros da fila. Vazio = todos que mudaram de posição.
DRIVER_MESSAGES_TOP=
# "Send Message to Vehicle(s)" da Vehicle API (mensagem da central para o motorista).
AUTOCAB_DRIVER_MESSAGE_PATH=/vehicle/v1/vehicles/message
# Campos extras do corpo para enviar como urgente (JSON). Não documentado na especificação.
AUTOCAB_DRIVER_MESSAGE_FIELDS={"urgent":true}
PROTECTED_ZONES=NAK,FORA DE AREA
OUTSIDE_ZONE_NAME=FORA DE AREA
AUTO_START=true
CYCLE_INTERVAL_MS=60000
# Exigido ao expor HOST fora do loopback. Use HTTPS para acesso remoto.
PANEL_TOKEN=
